			(thermal_bridge_width 0.5)
			(island_removal_mode 0)
		)
		(polygon
			(pts
				(xy 100 40) (xy 170 40) (xy 170 135) (xy 135 135) (xy 135 150) (xy 100 150)
			)
		)
	)
	(embedded_fonts no)
)
