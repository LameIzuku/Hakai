  (text "nRF52833 notes: DEC3 = 100pF NP0 (NOT 100nF). DEC4+DEC6 tied = DEC4_6 net. DEC5 N.C. on build codes Bxx+ (spec QIAAB0+)." (exclude_from_sim no) (at 148.59 110.49 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "6f2dd262-7d52-4d64-a14a-fdd590d37f5a")
  )
  (text "DC/DC REG1: DCC -> 10uH + 15nH -> DEC4_6 (halves radio current vs LDO mode). nRESET = P0.18 via UICR PSELRESET." (exclude_from_sim no) (at 148.59 114.3 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "007145a5-22a5-4e1e-baf7-8b1190d1d38a")
  )
  (text "RF match per Nordic PS/PCA10100 (VERBATIM): shunt 1.0pF -> series 4.7nH ->" (exclude_from_sim no) (at 292.1 105.41 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "2f388473-40c3-47ea-9014-204e80df0df3")
  )
  (text "shunt 1.2pF -> series 2.2nH -> 50R feed. COPY the reference LAYOUT geometry." (exclude_from_sim no) (at 292.1 109.22 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "3f3c07d4-c789-423d-bb07-cf362aa3faa3")
  )
  (text "C24 = antenna-dependent tune (DNP, set with VNA). Keep-out under antenna." (exclude_from_sim no) (at 292.1 113.03 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "768a2d7d-4353-49e2-abe2-33b65aca22cf")
  )
  (text "U5 PAW3311DB - VERIFIED per PixArt datasheet v1.0 (1A009EN):" (exclude_from_sim no) (at 303.53 158.75 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "0cb3bbfd-4f1c-49f0-9566-2ea87ade0cfb")
  )
  (text "VDD 1.8-2.1V, ABS MAX 2.1V. 3-wire SPI: MCU MISO -> SDIO direct;" (exclude_from_sim no) (at 303.53 162.56 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "dc4f52f5-620d-4306-8a63-8776666241ec")
  )
  (text "MCU MOSI -> R23 -> SDIO. R23: 3.3k@2MHz / 1k@4MHz / 240R@8MHz." (exclude_from_sim no) (at 303.53 166.37 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "c8386de0-ea29-487d-a527-46b652952a53")
  )
  (text "MOTION = push-pull active-low (R14 optional). VDDREG = bypass only." (exclude_from_sim no) (at 303.53 170.18 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "bc2a9546-7310-478b-abfe-067556f379d9")
  )
  (text "LED: 1V9_A -> 18R 1% -> IR LED -> pin1 (24mA internal control)." (exclude_from_sim no) (at 303.53 173.99 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "89a32d25-dce3-4f0d-892b-c5edb8b8062c")
  )
  (text "Lens: LM31-LNG/LM33-LSG/L0AL-LSG1 (5mm IR) or L0AJ-LSG1 (SMT IR). Z = 2.2-2.6mm." (exclude_from_sim no) (at 302.26 224.79 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "3345a76e-3254-4812-8a9a-ec39b3c26847")
  )
  (text "Kailh GM 8.0: COM->GND, NO->MCU (active-low). Debounce caps DNP - firmware debounces." (exclude_from_sim no) (at 121.92 256.54 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "592ca3ef-1620-4279-b466-1c8032b98f47")
  )
